# === 阿斯拉量化系統 - 環境變數範例 ===
# 複製此檔案為 .env 並填入你的設定

# 伺服器設定
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Redis 快取（可選，不設定則使用記憶體快取）
REDIS_URL=redis://localhost:6379/0

# 數據存儲路徑
DATA_DIR=./data

# 預設 LLM 設定（使用者也可在前端設定）
# 支援: openai, gemini, claude, ollama
DEFAULT_LLM_PROVIDER=openai
# API Key 由使用者在前端輸入，此處僅作為後備
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OLLAMA_BASE_URL=http://localhost:11434

# 日誌等級
LOG_LEVEL=INFO
